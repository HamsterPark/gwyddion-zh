#: modules/file/err.h:90
#, c-format
msgid ""
"File is not a %s file, it is seriously damaged, or it is of an unknown "
"format version."
msgstr "該檔案不是 %s 檔案，或者已嚴重損毀，或者屬於未知的格式版本。"

#: modules/file/err.h:101
#, c-format
msgid ""
"Expected data size calculated from file headers is %u bytes, but the real "
"size is %u bytes."
msgstr "根據檔頭算出的預期資料大小為 %u 位元組，實際大小為 %u 位元組。"

#. TRANSLATORS: %s is replaced by some item, struct or file part id.
#: modules/file/err.h:111
#, c-format
msgid "File component/item ‘%s’ is truncated."
msgstr "檔案元件 ‘%s’ 不完整。"

#: modules/file/err.h:118
msgid "File header is truncated."
msgstr "檔頭不完整。"

#: modules/file/err.h:136
#, c-format
msgid ""
"The number of bits per sample %d is invalid or unsupported for this file "
"type."
msgstr "對於此檔案型別，每取樣位元數 %d 無效或不受支援。"

#: modules/file/err.h:145
#, c-format
msgid "Data type %d is invalid or unsupported."
msgstr "資料型別 %d 無效或不受支援。"

#: modules/file/err.h:152
#, c-format
msgid "Header field `%s' is missing."
msgstr "缺少檔頭欄位 `%s’。"

#: modules/file/err.h:160
#, c-format
msgid "The value of parameter `%s' is invalid or unsupported."
msgstr "參數 `%s’ 的值無效或不受支援。"

#: modules/file/err.h:168
#, c-format
msgid "Parameter `%s' is missing or invalid."
msgstr "參數 `%s’ 遺漏或無效。"

#: modules/file/err.h:176
msgid "File contains no (importable) data."
msgstr "檔案中沒有（可匯入的）資料。"

#: modules/file/err.h:199
#, c-format
msgid "XML parsing failed: %s"
msgstr "XML 剖析失敗：%s"

#: modules/file/err.h:209
msgid "Inconsistent structure of individual spectra."
msgstr "各條譜的結構不一致。"

#: modules/file/err.h:217
msgid "File contains no exportable channel."
msgstr "檔案中沒有可匯出的通道。"

#: modules/file/err.h:225
msgid "File import was canceled by user."
msgstr "使用者取消了檔案匯入。"

#: modules/file/err.h:239
msgid "Missing header."
msgstr "缺少檔頭。"

