#, c-format
msgid ""
"<b>Too short file</b>\n"
"The format would require %lu bytes long file (at least), but the length of "
"`%s' is only %u bytes."
msgstr "<b>文件过短</b>\n此格式至少需要 %lu 字节，但 `%s’ 的长度只有 %u 字节。"

