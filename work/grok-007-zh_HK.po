#: modules/file/rawfile.c:1135
#, c-format
msgid ""
"<b>Too short file</b>\n"
"The format would require %lu bytes long file (at least), but the length of `%s' is only %u bytes."
msgstr ""
"<b>檔案過短</b>\n"
"此格式至少需要 %lu 位元組，但 `%s’ 的長度只有 %u 位元組。"

#: modules/file/rawfile.c:1166
#, c-format
msgid ""
"<b>Parsing failed</b>\n"
"The contents of `%s' does not match format: %s."
msgstr ""
"<b>解析失敗</b>\n"
"`%s’ 的內容與格式不符：%s。"

